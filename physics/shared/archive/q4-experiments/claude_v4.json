{
    "curriculum": {
      "unit7": {
        "title": "Waves and Harmonics",
        "sections": {
          "8.1": {
            "title": "Wave-Particle Energies",
            "key_formulae": [
              {
                "name": "Photon Energy",
                "formula": "E = hf",
                "variables": {
                  "E": "Energy of photon (J)",
                  "h": "Planck's constant (6.626 × 10^-34 J·s)",
                  "f": "Frequency of light (Hz)"
                }
              },
              {
                "name": "Wave Equation",
                "formula": "λf = c",
                "variables": {
                  "λ": "Wavelength (m)",
                  "f": "Frequency (Hz)",
                  "c": "Speed of light (3 × 10^8 m/s)"
                }
              },
              {
                "name": "Photoelectric Effect",
                "formula": "KEmax = hf - φ",
                "variables": {
                  "KEmax": "Maximum kinetic energy of ejected electron (J)",
                  "h": "Planck's constant (6.626 × 10^-34 J·s)",
                  "f": "Frequency of incident light (Hz)",
                  "φ": "Work function of metal (J)"
                }
              }
            ],
            "vocabulary": [
              {
                "term": "Photon",
                "definition": "A discrete packet or quantum of electromagnetic energy"
              },
              {
                "term": "Wave-Particle Duality",
                "definition": "The concept that light exhibits both wave and particle properties"
              },
              {
                "term": "Photoelectric Effect",
                "definition": "The emission of electrons when light strikes a material"
              },
              {
                "term": "Planck's Constant",
                "definition": "Fundamental physical constant relating energy of a photon to its frequency"
              },
              {
                "term": "Energy Quantization",
                "definition": "The concept that energy occurs in discrete amounts rather than continuously"
              }
            ],
            "concepts": [
              "Light exhibits both wave and particle properties",
              "Electromagnetic waves can behave as discrete particles (photons)",
              "Energy of electromagnetic radiation comes in discrete packets",
              "Photoelectric effect demonstrates particle nature of light",
              "Higher frequency light corresponds to higher energy photons"
            ]
          },
          "8.2": {
            "title": "Electric Charges and Fields",
            "key_formulae": [
              {
                "name": "Coulomb's Law",
                "formula": "F = k(q₁q₂)/r²",
                "variables": {
                  "F": "Force between charges (N)",
                  "k": "Coulomb's constant (8.99 × 10⁹ N⋅m²/C²)",
                  "q₁": "First charge (C)",
                  "q₂": "Second charge (C)",
                  "r": "Distance between charges (m)"
                }
              },
              {
                "name": "Electric Field Strength",
                "formula": "E = F/q",
                "variables": {
                  "E": "Electric field strength (N/C)",
                  "F": "Force on a charge (N)",
                  "q": "Test charge (C)"
                }
              },
              {
                "name": "Gauss's Law",
                "formula": "∮E⋅dA = Q/ε₀",
                "variables": {
                  "E": "Electric field (N/C)",
                  "dA": "Area element (m²)",
                  "Q": "Enclosed charge (C)",
                  "ε₀": "Permittivity of free space (F/m)"
                }
              },
              {
                "name": "Electric Potential",
                "formula": "V = W/q",
                "variables": {
                  "V": "Electric potential (V)",
                  "W": "Work done (J)",
                  "q": "Charge (C)"
                }
              }
            ],
            "vocabulary": [
              {
                "term": "Electric Charge",
                "definition": "A fundamental property of matter that causes it to experience force in electromagnetic fields"
              },
              {
                "term": "Electric Field",
                "definition": "A region where electric forces act on charged particles"
              },
              {
                "term": "Coulomb's Constant",
                "definition": "The proportionality constant in Coulomb's law"
              },
              {
                "term": "Gauss's Law",
                "definition": "Relates electric flux through a closed surface to the enclosed electric charge"
              },
              {
                "term": "Electric Potential",
                "definition": "The work done per unit charge to move a test charge from a reference point to a specific point"
              }
            ],
            "concepts": [
              "Like charges repel, opposite charges attract",
              "Electric charge is conserved in isolated systems",
              "Electric field lines show direction of force",
              "Field lines point from positive to negative charge",
              "Electric potential creates electric fields"
            ]
          },
          "8.3": {
            "title": "Electromagnetic Power and Energy",
            "key_formulae": [
              {
                "name": "Electric Power",
                "formula": "P = VI",
                "variables": {
                  "P": "Power (W)",
                  "V": "Voltage (V)",
                  "I": "Current (A)"
                }
              },
              {
                "name": "Faraday's Law",
                "formula": "EMF = -N(ΔΦ/Δt)",
                "variables": {
                  "EMF": "Electromotive force (V)",
                  "N": "Number of turns in coil",
                  "ΔΦ": "Change in magnetic flux (Wb)",
                  "Δt": "Change in time (s)"
                }
              },
              {
                "name": "Power Loss",
                "formula": "P = I²R",
                "variables": {
                  "P": "Power loss (W)",
                  "I": "Current (A)",
                  "R": "Resistance (Ω)"
                }
              },
              {
                "name": "Electric Field Energy",
                "formula": "UE = ½CV²",
                "variables": {
                  "UE": "Electric field energy (J)",
                  "C": "Capacitance (F)",
                  "V": "Voltage (V)"
                }
              },
              {
                "name": "Magnetic Field Energy",
                "formula": "UB = ½LI²",
                "variables": {
                  "UB": "Magnetic field energy (J)",
                  "L": "Inductance (H)",
                  "I": "Current (A)"
                }
              },
              {
                "name": "Speed of Light from Maxwell's Equations",
                "formula": "c = 1/√(ε₀μ₀)",
                "variables": {
                  "c": "Speed of light (m/s)",
                  "ε₀": "Permittivity of free space (F/m)",
                  "μ₀": "Permeability of free space (H/m)"
                }
              }
            ],
            "vocabulary": [
              {
                "term": "Electromagnetic Induction",
                "definition": "The production of voltage across a conductor in a changing magnetic field"
              },
              {
                "term": "Electromotive Force (EMF)",
                "definition": "The energy per unit charge that is converted from non-electrical to electrical form"
              },
              {
                "term": "Lenz's Law",
                "definition": "The direction of induced current opposes the change that produced it"
              },
              {
                "term": "Maxwell's Equations",
                "definition": "Four fundamental equations that describe all electromagnetic phenomena"
              },
              {
                "term": "Transformer",
                "definition": "A device that transfers electrical energy between circuits through electromagnetic induction"
              }
            ],
            "concepts": [
              "Moving magnets create electric fields",
              "Changing magnetic fields induce current flow",
              "High voltage reduces current and power loss in transmission",
              "Both electric and magnetic fields store energy",
              "Maxwell's equations unify electricity and magnetism"
            ]
          }
        }
      },
      "unit9": {
        "title": "Electricity",
        "sections": {
          "9.1": {
            "title": "Electrostatics",
            "key_formulae": [
              {
                "name": "Capacitance",
                "formula": "C = Q/V",
                "variables": {
                  "C": "Capacitance (F)",
                  "Q": "Charge (C)",
                  "V": "Voltage (V)"
                }
              },
              {
                "name": "Electric Field",
                "formula": "E = F/q",
                "variables": {
                  "E": "Electric field (N/C)",
                  "F": "Force (N)",
                  "q": "Charge (C)"
                }
              },
              {
                "name": "Potential Difference",
                "formula": "V = W/q",
                "variables": {
                  "V": "Potential difference (V)",
                  "W": "Work done (J)",
                  "q": "Charge (C)"
                }
              },
              {
                "name": "Capacitor Energy",
                "formula": "U = ½CV²",
                "variables": {
                  "U": "Energy stored (J)",
                  "C": "Capacitance (F)",
                  "V": "Voltage (V)"
                }
              }
            ],
            "vocabulary": [
              {
                "term": "Static Electricity",
                "definition": "The buildup of electric charge on the surface of objects"
              },
              {
                "term": "Conductor",
                "definition": "A material that allows charge to flow freely"
              },
              {
                "term": "Insulator",
                "definition": "A material that restricts the flow of charge"
              },
              {
                "term": "Charge Density",
                "definition": "The amount of electric charge per unit volume, area, or length"
              },
              {
                "term": "Equipotential Surface",
                "definition": "A surface where the electric potential is the same at every point"
              },
              {
                "term": "Capacitance",
                "definition": "The ability of a system to store electric charge"
              }
            ],
            "concepts": [
              "Objects can become charged by friction or contact",
              "Charge transfer occurs between materials",
              "Charges redistribute to minimize potential energy",
              "Conductors hold charge on their surface",
              "Sharp points concentrate charge"
            ]
          },
          "9.2": {
            "title": "Electric Circuits",
            "key_formulae": [
              {
                "name": "Ohm's Law",
                "formula": "V = IR",
                "variables": {
                  "V": "Voltage (V)",
                  "I": "Current (A)",
                  "R": "Resistance (Ω)"
                }
              },
              {
                "name": "Electric Power",
                "formula": "P = VI = I²R = V²/R",
                "variables": {
                  "P": "Power (W)",
                  "V": "Voltage (V)",
                  "I": "Current (A)",
                  "R": "Resistance (Ω)"
                }
              },
              {
                "name": "Energy Transfer",
                "formula": "E = Pt",
                "variables": {
                  "E": "Energy (J)",
                  "P": "Power (W)",
                  "t": "Time (s)"
                }
              },
              {
                "name": "Series Resistance",
                "formula": "Rtotal = R₁ + R₂ + R₃",
                "variables": {
                  "Rtotal": "Total resistance (Ω)",
                  "R₁, R₂, R₃": "Individual resistances (Ω)"
                }
              },
              {
                "name": "Parallel Resistance",
                "formula": "1/Rtotal = 1/R₁ + 1/R₂ + 1/R₃",
                "variables": {
                  "Rtotal": "Total resistance (Ω)",
                  "R₁, R₂, R₃": "Individual resistances (Ω)"
                }
              }
            ],
            "vocabulary": [
              {
                "term": "Electric Current",
                "definition": "The flow of electric charge through a conductor"
              },
              {
                "term": "Voltage",
                "definition": "Electric potential difference between two points"
              },
              {
                "term": "Resistance",
                "definition": "The opposition to the flow of electric current"
              },
              {
                "term": "Series Circuit",
                "definition": "A circuit where components are connected sequentially in a single path"
              },
              {
                "term": "Parallel Circuit",
                "definition": "A circuit where components are connected across the same potential difference"
              },
              {
                "term": "Kirchhoff's Current Law (KCL)",
                "definition": "The sum of currents entering a junction equals the sum of currents leaving the junction"
              },
              {
                "term": "Kirchhoff's Voltage Law (KVL)",
                "definition": "The sum of all voltage changes around any closed loop in a circuit equals zero"
              }
            ],
            "concepts": [
              "Current flows from higher to lower potential",
              "In series circuits, same current flows through all components",
              "In parallel circuits, voltage is the same across all branches",
              "Kirchhoff's laws apply conservation principles to circuits",
              "Electrical energy can be converted to heat in resistors"
            ]
          }
        }
      },
      "unit10": {
        "title": "Optics",
        "sections": {
          "10.1": {
            "title": "Geometric Optics",
            "key_formulae": [
              {
                "name": "Snell's Law",
                "formula": "n₁sin(θ₁) = n₂sin(θ₂)",
                "variables": {
                  "n₁": "Refractive index of first medium",
                  "n₂": "Refractive index of second medium",
                  "θ₁": "Angle of incidence",
                  "θ₂": "Angle of refraction"
                }
              },
              {
                "name": "Mirror/Lens Equation",
                "formula": "1/f = 1/p + 1/i",
                "variables": {
                  "f": "Focal length",
                  "p": "Object distance",
                  "i": "Image distance"
                }
              },
              {
                "name": "Magnification",
                "formula": "m = -i/p",
                "variables": {
                  "m": "Magnification",
                  "i": "Image distance",
                  "p": "Object distance"
                }
              }
            ],
            "vocabulary": [
              {
                "term": "Reflection",
                "definition": "The change in direction of a wave at an interface that returns into the original medium"
              },
              {
                "term": "Refraction",
                "definition": "The change in direction of a wave when passing from one medium to another"
              },
              {
                "term": "Total Internal Reflection",
                "definition": "The complete reflection of light when it attempts to pass from a denser to a less dense medium at an angle greater than the critical angle"
              },
              {
                "term": "Focal Point",
                "definition": "The point where parallel rays of light converge or appear to diverge after passing through a lens or reflecting from a mirror"
              },
              {
                "term": "Converging Lens",
                "definition": "A lens that causes parallel rays of light to converge to a focus"
              },
              {
                "term": "Diverging Lens",
                "definition": "A lens that causes parallel rays of light to diverge as if from a focus"
              }
            ],
            "concepts": [
              "Light rays travel in straight lines",
              "Angle of incidence equals angle of reflection",
              "Light changes direction when moving between different media",
              "Curved mirrors and lenses form images according to the mirror/lens equation",
              "Optical instruments use combinations of lenses and mirrors"
            ]
          },
          "10.2": {
            "title": "Wave Optics",
            "key_formulae": [
              {
                "name": "Wave Equation",
                "formula": "c = λf",
                "variables": {
                  "c": "Speed of light (3 × 10⁸ m/s)",
                  "λ": "Wavelength (m)",
                  "f": "Frequency (Hz)"
                }
              },
              {
                "name": "Diffraction Grating",
                "formula": "d sin θ = mλ",
                "variables": {
                  "d": "Grating spacing (m)",
                  "θ": "Angle of diffraction",
                  "m": "Order of diffraction (integer)",
                  "λ": "Wavelength (m)"
                }
              },
              {
                "name": "Malus's Law",
                "formula": "I = I₀cos²θ",
                "variables": {
                  "I": "Transmitted light intensity",
                  "I₀": "Initial light intensity",
                  "θ": "Angle between polarizer axes"
                }
              }
            ],
            "vocabulary": [
              {
                "term": "Interference",
                "definition": "The combination of waves resulting in a new wave pattern"
              },
              {
                "term": "Constructive Interference",
                "definition": "When waves combine to create a larger amplitude"
              },
              {
                "term": "Destructive Interference",
                "definition": "When waves combine to reduce or cancel the amplitude"
              },
              {
                "term": "Diffraction",
                "definition": "The bending of waves around obstacles or through openings"
              },
              {
                "term": "Polarization",
                "definition": "The restriction of vibrations of electromagnetic waves to a single plane"
              },
              {
                "term": "Diffraction Grating",
                "definition": "An optical component with a periodic structure that splits light into beams traveling in different directions"
              }
            ],
            "concepts": [
              "Light propagates as electromagnetic waves",
              "Visible light has wavelengths between 380-700 nanometers",
              "Waves combine through superposition principle",
              "Diffraction demonstrates wave nature of light",
              "Polarization shows transverse nature of light waves"
            ]
          }
        }
      }
    }
