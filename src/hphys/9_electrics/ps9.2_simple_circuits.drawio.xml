<!--
This XML can be imported into draw.io (diagrams.net) to render the circuit diagrams for PS 9.2.
Each diagram is on a separate page/layer.
-->

<mxfile host="app.diagrams.net">
  <diagram name="Series Circuit" id="series-circuit">
    <mxGraphModel dx="1000" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <!-- Battery -->
        <mxCell id="2" value="" style="electrical.battery;direction=west;" vertex="1" parent="1">
          <mxGeometry x="60" y="120" width="40" height="20" as="geometry"/>
        </mxCell>
        <!-- Resistor 1 -->
        <mxCell id="3" value="R1" style="electrical.resistor;direction=east;" vertex="1" parent="1">
          <mxGeometry x="100" y="120" width="60" height="20" as="geometry"/>
        </mxCell>
        <!-- Resistor 2 -->
        <mxCell id="4" value="R2" style="electrical.resistor;direction=south;" vertex="1" parent="1">
          <mxGeometry x="160" y="120" width="20" height="60" as="geometry"/>
        </mxCell>
        <!-- Wires -->
        <mxCell id="5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;" edge="1" parent="1" source="2" target="3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;" edge="1" parent="1" source="3" target="4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;" edge="1" parent="1" source="4">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="170" y="180" as="targetPoint"/>
            <mxPoint x="60" y="180" as="sourcePoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;" edge="1" parent="1" target="2">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="60" y="180" as="targetPoint"/>
            <mxPoint x="60" y="120" as="sourcePoint"/>
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="Parallel Circuit" id="parallel-circuit">
    <mxGraphModel dx="1000" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <!-- Battery -->
        <mxCell id="2" value="" style="electrical.battery;direction=west;" vertex="1" parent="1">
          <mxGeometry x="60" y="120" width="40" height="20" as="geometry"/>
        </mxCell>
        <!-- Top wire -->
        <mxCell id="3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;" edge="1" parent="1" source="2">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="180" y="130" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <!-- Bottom wire -->
        <mxCell id="4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;" edge="1" parent="1" source="2">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="180" y="170" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <!-- Resistor 1 (top branch) -->
        <mxCell id="5" value="R1" style="electrical.resistor;direction=east;" vertex="1" parent="1">
          <mxGeometry x="100" y="120" width="80" height="20" as="geometry"/>
        </mxCell>
        <!-- Resistor 2 (bottom branch) -->
        <mxCell id="6" value="R2" style="electrical.resistor;direction=east;" vertex="1" parent="1">
          <mxGeometry x="100" y="160" width="80" height="20" as="geometry"/>
        </mxCell>
        <!-- Right vertical wire -->
        <mxCell id="7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;" edge="1" parent="1" source="5">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="180" y="170" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;" edge="1" parent="1" source="6">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="180" y="130" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <!-- Closing left vertical wire -->
        <mxCell id="9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="60" y="170" as="targetPoint"/>
            <mxPoint x="60" y="120" as="sourcePoint"/>
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
