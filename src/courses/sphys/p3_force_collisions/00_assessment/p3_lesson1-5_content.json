    "P3L5": {
      "title": "Mass, Speed, and Force - Momentum Conservation",
      "learning_objectives": [
        "Discover conservation of momentum",
        "Apply momentum conservation to collision problems",
        "Distinguish between elastic and inelastic collisions",
        "Use geometric models to visualize momentum"
      ],
      "key_concepts": [
        "Momentum conservation",
        "Elastic vs inelastic collisions",
        "Momentum as conserved quantity",
        "Collision system boundaries",
        "Geometric momentum models"
      ],
      "key_terms": [
        "momentum",
        "conservation of momentum",
        "elastic collision",
        "inelastic collision",
        "system boundary",
        "conserved quantity",
        "momentum change"
      ],
      "equations": [
        "p = mv (momentum)",
        "Δp = mΔv (momentum change)",
        "p_before = p_after (conservation)",
        "m₁v₁ + m₂v₂ = m₁v₁' + m₂v₂'",
        "m₁Δv₁ + m₂Δv₂ = 0",
        "For inelastic: m₁v₁ + m₂v₂ = (m₁ + m₂)v_final"
      ],
      "principles": [
        "Momentum is conserved in all collisions",
        "Total momentum before = total momentum after",
        "In elastic collisions, objects separate after impact",
        "In inelastic collisions, objects stick together",
        "System momentum change = 0 for isolated systems"
      ],
      "assessment_topics": [
        "Momentum calculations",
        "Conservation law applications",
        "Collision type identification",
        "System boundary analysis",
        "Real-world collision predictions"
      ]
