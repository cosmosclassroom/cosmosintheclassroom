{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Course Configuration Schema",
  "description": "Configuration for a course including available structures, voice profiles, and integration settings",
  "type": "object",
  "properties": {
    "courseId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "description": "Unique identifier for this course"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "description": "Human-readable course name"
    },
    "description": {
      "type": "string",
      "maxLength": 500
    },
    "level": {
      "type": "string",
      "enum": ["middle-school", "high-school", "honors", "ap", "college", "graduate"]
    },
    "subject": {
      "type": "string",
      "enum": ["biology", "chemistry", "physics", "earth-science", "environmental", "anatomy", "astronomy", "interdisciplinary"]
    },
    "availableStructures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/structureReference"
      },
      "description": "Three-part structures available for this course"
    },
    "defaultVoice": {
      "$ref": "#/definitions/voiceProfile"
    },
    "chunkingDefaults": {
      "$ref": "#/definitions/chunkingDefaults"
    },
    "integrations": {
      "$ref": "#/definitions/integrations"
    },
    "navigation": {
      "$ref": "#/definitions/navigationConfig"
    },
    "branding": {
      "$ref": "#/definitions/brandingConfig"
    },
    "metadata": {
      "$ref": "#/definitions/courseMetadata"
    }
  },
  "required": ["courseId", "name", "level", "subject", "availableStructures", "defaultVoice"],
  "additionalProperties": false,
  
  "definitions": {
    "structureReference": {
      "type": "object",
      "properties": {
        "structureId": {
          "type": "string",
          "description": "References a three-part structure definition"
        },
        "name": {
          "type": "string",
          "description": "Display name for this structure in this course context"
        },
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "customizations": {
          "type": "object",
          "description": "Course-specific overrides for this structure",
          "properties": {
            "voiceOverride": {
              "$ref": "#/definitions/voiceProfile"
            },
            "fieldOverrides": {
              "type": "object",
              "patternProperties": {
                "^[a-z][a-z0-9-]*$": {
                  "type": "object",
                  "description": "Field-specific overrides by fieldId"
                }
              }
            },
            "chunkingOverride": {
              "$ref": "#/definitions/chunkingDefaults"
            }
          }
        },
        "prerequisites": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Unit or lesson prerequisites for using this structure"
        }
      },
      "required": ["structureId"],
      "additionalProperties": false
    },
    
    "voiceProfile": {
      "type": "object",
      "properties": {
        "primary": {
          "type": "string",
          "enum": ["socrates", "burke", "sagan", "feynman"]
        },
        "secondary": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["socrates", "burke", "sagan", "feynman"]
          },
          "maxItems": 2
        },
        "tone": {
          "type": "string",
          "enum": ["inquiry", "discovery", "analytical", "playful", "contemplative"]
        },
        "complexity": {
          "type": "string",
          "enum": ["middle-school", "high-school", "college", "graduate"]
        },
        "customPhrases": {
          "type": "object",
          "description": "Course-specific language and phrases",
          "properties": {
            "welcomeMessage": {"type": "string"},
            "encouragementPhrases": {
              "type": "array",
              "items": {"type": "string"}
            },
            "transitionPhrases": {
              "type": "array", 
              "items": {"type": "string"}
            },
            "completionMessages": {
              "type": "array",
              "items": {"type": "string"}
            }
          }
        }
      },
      "required": ["primary", "tone", "complexity"],
      "additionalProperties": false
    },
    
    "chunkingDefaults": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "defaultSize": {
          "type": "string",
          "enum": ["small", "medium", "large", "adaptive"],
          "default": "medium"
        },
        "allowStudentControl": {
          "type": "boolean",
          "default": true,
          "description": "Whether students can adjust chunk sizes"
        },
        "adaptiveSettings": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "basedOn": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["completion-time", "engagement-metrics", "prior-performance"]
              }
            }
          }
        }
      },
      "additionalProperties": false
    },
    
    "integrations": {
      "type": "object",
      "properties": {
        "chunker": {
          "type": "object",
          "properties": {
            "endpoint": {
              "type": "string",
              "format": "uri"
            },
            "apiKey": {
              "type": "string"
            },
            "config": {
              "type": "object",
              "description": "Chunker-specific configuration"
            }
          },
          "required": ["endpoint"]
        },
        "contentSources": {
          "type": "object",
          "properties": {
            "primary": {
              "type": "string",
              "enum": ["markdown-files", "json-arrays", "external-api", "database"]
            },
            "fallback": {
              "type": "string",
              "enum": ["markdown-files", "json-arrays", "external-api", "database"]
            },
            "paths": {
              "type": "object",
              "patternProperties": {
                "^(markdown-files|json-arrays)$": {
                  "type": "string",
                  "description": "File system path for local content"
                }
              }
            },
            "apis": {
              "type": "object",
              "patternProperties": {
                "^external-api$": {
                  "type": "object",
                  "properties": {
                    "baseUrl": {"type": "string", "format": "uri"},
                    "apiKey": {"type": "string"},
                    "endpoints": {"type": "object"}
                  }
                }
              }
            }
          }
        },
        "export": {
          "type": "object",
          "properties": {
            "formats": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["google-docs", "pdf", "html", "json"]
              }
            },
            "templates": {
              "type": "object",
              "patternProperties": {
                "^(google-docs|pdf|html)$": {
                  "type": "string",
                  "description": "Template file path for this format"
                }
              }
            }
          }
        }
      },
      "additionalProperties": false
    },
    
    "navigationConfig": {
      "type": "object",
      "properties": {
        "breadcrumbStyle": {
          "type": "string",
          "enum": ["minimal", "full", "contextual"],
          "default": "contextual"
        },
        "progressDisplay": {
          "type": "string",
          "enum": ["percentage", "fraction", "visual-only", "hidden"],
          "default": "fraction"
        },
        "phaseNavigation": {
          "type": "boolean",
          "default": true,
          "description": "Show the three-phase journey indicator"
        },
        "elementNavigation": {
          "type": "boolean", 
          "default": true,
          "description": "Show current phase element list"
        },
        "helpResources": {
          "type": "boolean",
          "default": true,
          "description": "Show contextual help links"
        },
        "timeAwareness": {
          "type": "string",
          "enum": ["suggestion", "countdown", "elapsed", "hidden"],
          "default": "suggestion"
        }
      },
      "additionalProperties": false
    },
    
    "brandingConfig": {
      "type": "object",
      "properties": {
        "colors": {
          "type": "object",
          "properties": {
            "primary": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "secondary": {
              "type": "string", 
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "accent": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            }
          }
        },
        "logo": {
          "type": "string",
          "description": "Path to course logo image"
        },
        "courseName": {
          "type": "string",
          "description": "Display name (may differ from config name)"
        },
        "instructor": {
          "type": "string",
          "description": "Instructor name for display"
        }
      },
      "additionalProperties": false
    },
    
    "courseMetadata": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "created": {
          "type": "string",
          "format": "date-time"
        },
        "lastModified": {
          "type": "string",
          "format": "date-time"
        },
        "author": {
          "type": "string"
        },
        "institution": {
          "type": "string"
        },
        "academicYear": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{4}$"
        },
        "semester": {
          "type": "string",
          "enum": ["fall", "spring", "summer", "year-long"]
        },
        "estimatedEnrollment": {
          "type": "integer",
          "minimum": 1
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
