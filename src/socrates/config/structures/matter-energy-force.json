{
  "structureId": "matter-energy-force",
  "name": "Matter-Energy-Force Investigation",
  "description": "Three-phase investigation structure for exploring scientific phenomena through matter, energy, and force lenses",
  "parts": [
    {
      "partId": "part1",
      "name": "Matter Phase",
      "description": "Focus on the substances, structures, and composition involved",
      "color": "#EA580C",
      "icon": "molecule",
      "elements": [
        {
          "elementId": "matter-observation",
          "title": "Observation & Questions",
          "type": "observation",
          "ngssTag": "practices",
          "fields": [
            {
              "fieldId": "initial-observations",
              "label": "What do you observe about the matter/materials involved?",
              "type": "text-long",
              "required": true,
              "validation": {
                "minLength": 50,
                "maxLength": 1000
              },
              "placeholder": "Describe the physical properties, structures, or substances you notice..."
            },
            {
              "fieldId": "matter-questions",
              "label": "What questions do you have about the matter involved?",
              "type": "structured-list",
              "required": true,
              "helpText": "Generate at least 3 questions about the substances, composition, or structure"
            }
          ]
        },
        {
          "elementId": "matter-investigation",
          "title": "Investigation Design",
          "type": "hypothesis-formation",
          "ngssTag": "practices",
          "dependencies": ["matter-observation"],
          "fields": [
            {
              "fieldId": "investigation-plan",
              "label": "How will you investigate the matter aspects?",
              "type": "text-long",
              "required": true,
              "validation": {
                "minLength": 100,
                "maxLength": 500
              }
            }
          ]
        }
      ],
      "expectedDuration": 25
    },
    {
      "partId": "part2", 
      "name": "Energy Phase",
      "description": "Focus on energy transfers, transformations, and flows",
      "color": "#2563EB",
      "icon": "lightning",
      "elements": [
        {
          "elementId": "energy-analysis",
          "title": "Energy Identification",
          "type": "analysis",
          "ngssTag": "dci",
          "fields": [
            {
              "fieldId": "energy-types",
              "label": "What types of energy are involved?",
              "type": "checkbox-list",
              "required": true,
              "helpText": "Identify all forms of energy present in your phenomenon"
            },
            {
              "fieldId": "energy-transfers",
              "label": "How is energy being transferred or transformed?",
              "type": "text-long",
              "required": true,
              "validation": {
                "minLength": 75,
                "maxLength": 750
              }
            }
          ]
        }
      ],
      "expectedDuration": 20
    },
    {
      "partId": "part3",
      "name": "Force Phase", 
      "description": "Focus on forces, interactions, and cause-effect relationships",
      "color": "#16A34A",
      "icon": "arrow-up-down",
      "elements": [
        {
          "elementId": "force-analysis",
          "title": "Force & Interaction Analysis",
          "type": "analysis",
          "ngssTag": "crosscutting",
          "fields": [
            {
              "fieldId": "forces-present",
              "label": "What forces or interactions are at work?",
              "type": "text-long",
              "required": true,
              "validation": {
                "minLength": 50,
                "maxLength": 600
              }
            },
            {
              "fieldId": "cause-effect",
              "label": "What cause-and-effect relationships do you see?",
              "type": "text-long",
              "required": true
            }
          ]
        },
        {
          "elementId": "synthesis",
          "title": "Integration & Reflection",
          "type": "synthesis",
          "ngssTag": "metacognitive",
          "dependencies": ["matter-observation", "matter-investigation", "energy-analysis", "force-analysis"],
          "fields": [
            {
              "fieldId": "phase-connections",
              "label": "How do matter, energy, and forces work together in this phenomenon?",
              "type": "text-long",
              "required": true,
              "validation": {
                "minLength": 100,
                "maxLength": 1000
              }
            },
            {
              "fieldId": "new-questions",
              "label": "What new questions emerged from your investigation?",
              "type": "structured-list",
              "required": false
            }
          ]
        }
      ],
      "expectedDuration": 30
    }
  ],
  "voiceProfile": {
    "primary": "socrates",
    "secondary": ["sagan"],
    "tone": "inquiry",
    "complexity": "high-school"
  },
  "ngssAlignment": {
    "practices": ["SEP-1", "SEP-3", "SEP-6"],
    "dci": ["PS1.A", "PS3.A", "PS2.A"],
    "crosscutting": ["CCC-2", "CCC-6"]
  },
  "chunkingStrategy": {
    "enabled": true,
    "chunkSize": "medium",
    "breakpoints": ["after-observation", "between-phases", "before-synthesis"],
    "integration": {
      "chunkerEndpoint": "/api/chunker/process",
      "chunkerConfig": {
        "strategy": "natural-breaks",
        "targetSize": "15-20min",
        "preserveFlow": true
      }
    }
  },
  "metadata": {
    "version": "1.0.0",
    "author": "Socrates Development Team",
    "created": "2025-08-22T00:00:00Z",
    "tags": ["investigation", "three-phase", "ngss-aligned"],
    "difficulty": "intermediate",
    "estimatedTime": 75
  }
}
