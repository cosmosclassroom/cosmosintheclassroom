{
  "courseId": "ap-biology",
  "name": "AP Biology",
  "description": "Advanced Placement Biology with inquiry-based research briefs",
  "level": "ap",
  "subject": "biology",
  "availableStructures": [
    {
      "structureId": "matter-energy-force",
      "name": "Matter-Energy-Force Investigation",
      "enabled": true,
      "customizations": {
        "voiceOverride": {
          "primary": "sagan",
          "secondary": ["socrates"],
          "tone": "discovery",
          "complexity": "college"
        }
      },
      "prerequisites": ["unit-1-intro"]
    },
    {
      "structureId": "forecast-blueprint-reflection",
      "name": "Predictive Investigation",
      "enabled": true,
      "prerequisites": ["unit-2-methods"]
    },
    {
      "structureId": "structure-function-growth",
      "name": "Structure-Function-Growth Analysis",
      "enabled": true,
      "customizations": {
        "chunkingOverride": {
          "defaultSize": "large",
          "allowStudentControl": false
        }
      }
    }
  ],
  "defaultVoice": {
    "primary": "sagan",
    "secondary": ["socrates", "feynman"],
    "tone": "discovery",
    "complexity": "college",
    "customPhrases": {
      "welcomeMessage": "Welcome to AP Biology! Let's explore the magnificent complexity of life.",
      "encouragementPhrases": [
        "Your observations show real scientific thinking!",
        "This hypothesis demonstrates sophisticated reasoning.",
        "You're making connections like a true biologist."
      ],
      "transitionPhrases": [
        "Now that we've examined the matter, let's explore the energy...",
        "Building on your observations, consider the forces at work...",
        "Let's synthesize what we've discovered across all three phases..."
      ]
    }
  },
  "chunkingDefaults": {
    "enabled": true,
    "defaultSize": "medium",
    "allowStudentControl": true,
    "adaptiveSettings": {
      "enabled": true,
      "basedOn": ["completion-time", "engagement-metrics"]
    }
  },
  "integrations": {
    "chunker": {
      "endpoint": "http://localhost:3001/api/chunker",
      "config": {
        "strategy": "natural-breaks",
        "targetDuration": "15-20min",
        "preserveInquiryFlow": true,
        "adaptToStudentPace": true
      }
    },
    "contentSources": {
      "primary": "markdown-files",
      "fallback": "json-arrays",
      "paths": {
        "markdown-files": "./content/ap-biology/",
        "json-arrays": "./content/ap-biology/data/"
      }
    },
    "export": {
      "formats": ["google-docs", "pdf"],
      "templates": {
        "google-docs": "./templates/ap-biology-brief.docx",
        "pdf": "./templates/ap-biology-brief.html"
      }
    }
  },
  "navigation": {
    "breadcrumbStyle": "full",
    "progressDisplay": "fraction",
    "phaseNavigation": true,
    "elementNavigation": true,
    "helpResources": true,
    "timeAwareness": "suggestion"
  },
  "branding": {
