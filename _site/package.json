{
  "name": "cosmosintheclassroom",
  "version": "1.0.0",
  "description": "This is an instructional website by Jonathan Corbett.",
  "main": "index.js",
  "scripts": {
    "dev": "npm run watch-css & npm run serve",
    "build": "npm run build-css && npm run build-site && npm run build-slides",
    "build-css": "tailwindcss -i ./src/input.css -o ./src/portal/tailwind-output.css",
    "watch-css": "tailwindcss -i ./src/input.css -o ./src/portal/tailwind-output.css --watch",
    "build-site": "bundle exec jekyll build",
    "build-slides": "node scripts/build-slides.js",
    "serve": "bundle exec jekyll serve --livereload",
    "clean": "rm -rf _site && rm -rf .jekyll-cache",
    "validate": "node scripts/validate-content.js",
    "test": "npm run validate"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cosmosclassroom/cosmosintheclassroom.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/cosmosclassroom/cosmosintheclassroom/issues"
  },
  "homepage": "https://github.com/cosmosclassroom/cosmosintheclassroom#readme",
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.12",
    "tailwindcss": "^4.1.12",
    "glob": "^11.0.0"
  },
  "dependencies": {
    "glob": "^11.0.3"
  }
}
