{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WeekCentricChunker Configuration Schema",
  "description": "Schema for AI-generated curriculum configurations compatible with WeekCentricChunker system",
  "type": "object",
  "required": ["metadata", "schedule", "weeks"],
  "properties": {
    "metadata": {
      "type": "object",
      "required": ["courseName", "academicYear", "totalWeeks", "extractionVersion"],
      "properties": {
        "courseName": {
          "type": "string",
          "description": "Full course name (e.g., 'Physics - Honors Level')",
          "minLength": 3
        },
        "courseLevel": {
          "type": "string",
          "enum": ["honors", "standard", "AP", "dual-enrollment", "remedial"],
          "description": "Academic level of the course"
        },
        "academicYear": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{4}$",
          "description": "Academic year in format '2024-2025'"
        },
        "semester": {
          "type": "string",
          "enum": ["fall", "spring", "summer", "full-year"],
          "description": "Semester or session designation"
        },
        "totalWeeks": {
          "type": "integer",
          "minimum": 8,
          "maximum": 52,
          "description": "Total instructional weeks in the course"
        },
        "instructionalDaysPerWeek": {
          "type": "integer",
          "minimum": 1,
          "maximum": 7,
          "default": 5,
          "description": "Number of instructional days per week"
        },
        "periodsPerDay": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "default": 1,
          "description": "Number of class periods per day"
        },
        "minutesPerPeriod": {
          "type": "integer",
          "minimum": 30,
          "maximum": 180,
          "default": 50,
          "description": "Duration of each class period in minutes"
        },
        "extractionVersion": {
          "type": "string",
          "description": "Version of AI extraction system used",
          "default": "v2.0"
        },
        "extractionDate": {
          "type": "string",
          "format": "date",
          "description": "Date when curriculum was extracted"
        },
        "sourceDocuments": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "List of source documents used for extraction"
        }
      }
    },
    "schedule": {
      "type": "object",
      "required": ["startDate", "endDate"],
      "properties": {
        "startDate": {
          "type": "string",
          "format": "date",
          "description": "First day of instruction (YYYY-MM-DD)"
        },
        "endDate": {
          "type": "string",
          "format": "date",
          "description": "Last day of instruction (YYYY-MM-DD)"
        },
        "holidays": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["date", "name"],
            "properties": {
              "date": {
                "type": "string",
                "format": "date"
              },
              "name": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "enum": ["holiday", "break", "professional-day", "testing", "assembly"]
              }
            }
          },
          "description": "Non-instructional days"
        },
        "assessmentPeriods": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "startWeek", "endWeek"],
            "properties": {
              "name": {
                "type": "string",
                "description": "Name of assessment period (e.g., 'Quarter 1')"
              },
              "startWeek": {
                "type": "integer",
                "minimum": 1
              },
              "endWeek": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    },
    "weeks": {
      "type": "object",
      "patternProperties": {
        "^week_\\d+$": {
          "$ref": "#/definitions/weekObject"
        }
      },
      "additionalProperties": false,
      "description": "Weekly content organization"
    }
  },
  "definitions": {
    "weekObject": {
      "type": "object",
      "required": ["weekNumber", "startDate", "endDate", "chunks"],
      "properties": {
        "weekNumber": {
          "type": "integer",
          "minimum": 1,
          "description": "Sequential week number"
        },
        "startDate": {
          "type": "string",
          "format": "date",
          "description": "Monday of this week (YYYY-MM-DD)"
        },
        "endDate": {
          "type": "string",
          "format": "date",
          "description": "Friday of this week (YYYY-MM-DD)"
        },
        "theme": {
          "type": "string",
          "description": "Overarching theme or focus for the week"
        },
        "unit": {
          "type": "string",
          "description": "Unit or chapter this week belongs to"
        },
        "unitProgress": {
          "type": "object",
          "properties": {
            "position": {
              "type": "integer",
              "minimum": 1,
              "description": "Week position within the unit"
            },
            "totalWeeks": {
              "type": "integer",
              "minimum": 1,
              "description": "Total weeks in this unit"
            }
          }
        },
        "learningObjectives": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Weekly learning objectives in measurable terms"
        },
        "prerequisites": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Prior knowledge or skills needed this week"
        },
        "assessments": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type", "description"],
            "properties": {
              "type": {
                "type": "string",
                "enum": ["quiz", "test", "project", "lab", "presentation", "homework", "discussion"]
              },
              "description": {
                "type": "string"
              },
              "dueDate": {
                "type": "string",
                "format": "date"
              },
              "weight": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "description": "Assessment weight (0-1 scale)"
              }
            }
          }
        },
        "chunks": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/chunkObject"
          },
          "description": "Daily learning chunks for this week"
        }
      }
    },
    "chunkObject": {
      "type": "object",
      "required": ["id", "title", "day", "objectives"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]+$",
          "description": "Unique identifier for this chunk"
        },
        "title": {
          "type": "string",
          "minLength": 5,
          "maxLength": 100,
          "description": "Descriptive title for the learning chunk"
        },
        "day": {
          "type": "string",
          "enum": ["monday", "tuesday", "wednesday", "thursday", "friday", "saturday", "sunday"],
          "description": "Day of the week for this chunk"
        },
        "period": {
          "type": "integer",
          "minimum": 1,
          "description": "Class period number (if multiple periods per day)"
        },
        "duration": {
          "type": "integer",
          "minimum": 15,
          "maximum": 180,
          "description": "Expected duration in minutes"
        },
        "objectives": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "description": "Specific learning objectives for this chunk"
        },
        "content": {
          "type": "object",
          "properties": {
            "topics": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Main topics or concepts covered"
            },
            "activities": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Learning activities and instructional strategies"
            },
            "resources": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": ["textbook", "website", "video", "lab", "simulation", "worksheet", "presentation"]
                  },
                  "title": {
                    "type": "string"
                  },
                  "url": {
                    "type": "string",
                    "format": "uri"
                  },
                  "pages": {
                    "type": "string",
                    "description": "Page numbers or section references"
                  }
                }
              },
              "description": "Educational resources and materials"
            },
            "vocabulary": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Key vocabulary terms introduced"
            }
          }
        },
        "prerequisites": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Prerequisites for this specific chunk"
        },
        "difficulty": {
          "type": "string",
          "enum": ["introduction", "practice", "application", "synthesis", "assessment"],
          "description": "Cognitive complexity level using Bloom's taxonomy"
        },
        "cognitiveLoad": {
          "type": "string",
          "enum": ["low", "medium", "high"],
          "description": "Expected cognitive load for students. Guidelines: low (1 main concept/chunk), medium (2-3 related concepts), high (complex multi-step processes or synthesis)"
        },
        "teachingStrategy": {
          "type": "string",
          "enum": ["direct-instruction", "guided-practice", "independent-work", "collaboration", "inquiry", "lab", "discussion", "assessment"],
          "description": "Primary instructional approach"
        },
        "status": {
          "type": "string",
          "enum": ["not-started", "in-progress", "completed", "needs-review", "skipped"],
          "default": "not-started",
          "description": "Current completion status"
        },
        "progress": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0,
          "description": "Completion percentage (0-1 scale)"
        },
        "notes": {
          "type": "string",
          "description": "Teacher notes or observations about this chunk"
        },
        "adaptations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": ["extension", "remediation", "accommodation", "modification"]
              },
              "description": {
                "type": "string"
              },
              "targetStudents": {
                "type": "string",
                "description": "Which students this adaptation serves"
              }
            }
          },
          "description": "Instructional adaptations for diverse learners"
        }
      }
    }
  }
}
