{
  "name": "socrates-research-brief-generator",
  "version": "1.0.0",
  "description": "AI-powered research brief generator with three-part structures and NGSS 3D color coding",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "jest",
    "lint": "eslint src --ext .ts,.tsx",
    "format": "prettier --write src",
    "type-check": "tsc --noEmit",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "ajv": "^8.12.0",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "@types/node": "^20.5.0",
    "@types/express": "^4.17.17",
    "@types/cors": "^2.8.13",
    "@types/multer": "^1.4.7",
    "typescript": "^5.1.6",
    "vite": "^4.4.9",
    "@vitejs/plugin-react": "^4.0.4",
    "eslint": "^8.47.0",
    "@typescript-eslint/eslint-plugin": "^6.4.0",
    "@typescript-eslint/parser": "^6.4.0",
    "prettier": "^3.0.2",
    "jest": "^29.6.2",
    "@types/jest": "^29.5.4",
    "ts-jest": "^29.1.1"
  },
  "keywords": [
    "education",
    "research-briefs", 
    "ngss",
    "inquiry-based-learning",
    "science-education",
    "three-part-structures",
    "voice-synthesis",
    "chunking",
    "navigation"
  ],
  "author": "Cosmos in the Classroom Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cosmosclassroom/cosmosintheclassroom.git",
    "directory": "src/socrates"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
