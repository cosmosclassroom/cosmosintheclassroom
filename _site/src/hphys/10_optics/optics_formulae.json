{
  "title": "Optics Reference Formulae",
  "formulae": [
    {
      "phenomenon": "Wave relation",
      "equation": "$c = \\lambda f$",
      "description": "Relationship between speed of light, wavelength and frequency",
      "variables": {
        "c": "Speed of light (m/s)",
        "λ": "Wavelength (m)",
        "f": "Frequency (Hz)"
      }
    },
    {
      "phenomenon": "Law of reflection",
      "equation": "$\\theta_i = \\theta_r$",
      "description": "Angle of incidence equals angle of reflection",
      "variables": {
        "θ_i": "Angle of incidence (degrees)",
        "θ_r": "Angle of reflection (degrees)"
      }
    },
    {
      "phenomenon": "Snell's law",
      "equation": "$n_1 \\sin \\theta_1 = n_2 \\sin \\theta_2$",
      "description": "Relationship between angles of refraction and indices of refraction",
      "variables": {
        "n_1": "Refractive index of medium 1",
        "n_2": "Refractive index of medium 2",
        "θ_1": "Angle in medium 1 (degrees)",
        "θ_2": "Angle in medium 2 (degrees)"
      }
    },
    {
      "phenomenon": "Double-slit interference",
      "equation": "$d \\sin \\theta = m\\lambda$",
      "description": "Condition for constructive interference in a double-slit experiment",
      "variables": {
        "d": "Distance between slits (m)",
        "θ": "Angle to interference maximum (degrees)",
        "m": "Order of interference maximum (integer)",
        "λ": "Wavelength (m)"
      }
    },
    {
      "phenomenon": "Single-slit diffraction",
      "equation": "$a \\sin \\theta = m\\lambda$",
      "description": "Position of diffraction minima for a single slit",
      "variables": {
        "a": "Width of the slit (m)",
        "θ": "Angle to diffraction minimum (degrees)",
        "m": "Order of diffraction minimum (integer)",
        "λ": "Wavelength (m)"
      }
    },
    {
      "phenomenon": "Thin lens equation",
      "equation": "$\\frac{1}{s} + \\frac{1}{s'} = \\frac{1}{f}$",
      "description": "Relationship between object distance, image distance, and focal length",
      "variables": {
        "s": "Object distance (m)",
        "s'": "Image distance (m)",
        "f": "Focal length (m)"
      }
    },
    {
      "phenomenon": "Photon energy",
      "equation": "$E = hf = \\frac{hc}{\\lambda}$",
      "description": "Energy of a photon in terms of frequency or wavelength",
      "variables": {
        "E": "Energy of photon (J)",
        "h": "Planck's constant (J·s)",
        "f": "Frequency (Hz)",
        "c": "Speed of light (m/s)",
        "λ": "Wavelength (m)"
      }
    },
    {
      "phenomenon": "Wave equation",
      "equation": "$v = f \\lambda$",
      "description": "Relationship between wave speed, frequency and wavelength",
      "variables": {
        "v": "Wave speed (m/s)",
        "f": "Frequency (Hz)",
        "λ": "Wavelength (m)"
      }
    },
    {
      "phenomenon": "Speed of light",
      "equation": "$c = 3 \\times 10^8$ m/s",
      "description": "Speed of light in vacuum",
      "variables": {
        "c": "Speed of light (m/s)"
      }
    },
    {
      "phenomenon": "Einstein's equation",
      "equation": "$E=mc^2$",
      "description": "Relationship between energy and mass",
      "variables": {
        "E": "Energy (J)",
        "m": "Mass (kg)",
        "c": "Speed of light (m/s)"
      }
    },
    {
      "phenomenon": "Maxwell's equation (simplified)",
      "equation": "$c = \\frac{1}{\\sqrt{\\mu_0 \\epsilon_0}}$",
      "description": "Relationship between speed of light and electromagnetic constants",
      "variables": {
        "c": "Speed of light (m/s)",
        "μ_0": "Permeability of free space (H/m)",
        "ε_0": "Permittivity of free space (F/m)"
      }
    },
    {
      "phenomenon": "Total internal reflection",
      "equation": "$\\sin \\theta_i > \\frac{n_2}{n_1}$",
      "description": "Condition for total internal reflection",
      "variables": {
        "θ_i": "Angle of incidence (degrees)",
        "n_1": "Refractive index of first medium",
        "n_2": "Refractive index of second medium"
      }
    },
    {
      "phenomenon": "Thin lens equation (alternative form)",
      "equation": "$\\frac{1}{f} = \\frac{1}{d_o} + \\frac{1}{d_i}$",
      "description": "Relationship between focal length, object distance and image distance",
      "variables": {
        "f": "Focal length (m)",
        "d_o": "Object distance (m)",
        "d_i": "Image distance (m)"
      }
    },
    {
      "phenomenon": "Magnification formula",
      "equation": "$M = -\\frac{d_i}{d_o}$",
      "description": "Magnification in terms of image and object distances",
      "variables": {
        "M": "Magnification (dimensionless)",
        "d_i": "Image distance (m)",
        "d_o": "Object distance (m)"
      }
    },
    {
      "phenomenon": "Angular magnification",
      "equation": "$M = \\frac{\\theta'}{\\theta}$",
      "description": "Ratio of angular size seen through optical instrument to angular size seen by naked eye",
      "variables": {
        "M": "Angular magnification (dimensionless)",
        "θ'": "Angular size through instrument (rad)",
        "θ": "Angular size with naked eye (rad)"
      }
    },
    {
      "phenomenon": "Planck's constant",
      "equation": "$h = 6.63 \\times 10^{-34}$ J·s",
      "description": "Fundamental constant relating energy of a photon to its frequency",
      "variables": {
        "h": "Planck's constant (J·s)"
      }
    }
  ]
}
