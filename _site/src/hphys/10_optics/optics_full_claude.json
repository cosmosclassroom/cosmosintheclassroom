{
  "courseTitle": "High School Physics: Optics",
  "textbook": "Physics: Principles with Applications, 7th Edition",
  "author": "Douglas C. Giancoli",
  "description": "This index covers the optics section of Giancoli's Physics textbook, organized to facilitate content generation and file directory structure for an HTML interface.",
  "sections": [
    {
      "id": "section-1",
      "title": "Nature and Propagation of Light",
      "majorConcepts": [
        {
          "id": "concept-1-1",
          "title": "Historical Theories of Light",
          "subheadings": [
            "Particle Theory (Newton)",
            "Wave Theory (Huygens)",
            "Electromagnetic Theory (Maxwell)",
            "Quantum Theory (Einstein, Planck)"
          ],
          "annotation": "This section provides historical context for understanding the dual nature of light, which is essential for comprehending both geometric and physical optics."
        },
        {
          "id": "concept-1-2",
          "title": "Wave Properties of Light",
          "subheadings": [
            "Wavelength and Frequency",
            "Electromagnetic Spectrum",
            "Visible Light Spectrum",
            "Speed of Light"
          ],
          "formulae": [
            {
              "name": "Speed of Light in Vacuum",
              "formula": "c = 3.00 × 10^8 m/s"
            },
            {
              "name": "Wave Relation",
              "formula": "c = λf"
            },
            {
              "name": "Index of Refraction",
              "formula": "n = c/v"
            }
          ],
          "principles": [
            "Light travels in straight lines in a homogeneous medium",
            "Principle of least time (Fermat's principle)"
          ]
        },
        {
          "id": "concept-1-3",
          "title": "Light Propagation",
          "subheadings": [
            "Rectilinear Propagation",
            "Light Rays and Ray Diagrams",
            "Light Intensity and Distance",
            "Shadows and Umbra/Penumbra"
          ],
          "formulae": [
            {
              "name": "Inverse Square Law",
              "formula": "I ∝ 1/r²"
            }
          ],
          "annotation": "Students often struggle with ray diagrams - emphasize these as powerful visual tools for problem-solving throughout the optics unit."
        }
      ]
    },
    {
      "id": "section-2",
      "title": "Reflection and Mirrors",
      "majorConcepts": [
        {
          "id": "concept-2-1",
          "title": "Law of Reflection",
          "subheadings": [
            "Specular vs. Diffuse Reflection",
            "Angle of Incidence and Reflection",
            "Regular and Irregular Reflection"
          ],
          "formulae": [
            {
              "name": "Law of Reflection",
              "formula": "θᵢ = θᵣ"
            }
          ],
          "principles": [
            "Angle of incidence equals angle of reflection",
            "Incident ray, reflected ray, and normal all lie in the same plane"
          ]
        },
        {
          "id": "concept-2-2",
          "title": "Plane Mirrors",
          "subheadings": [
            "Image Formation",
            "Virtual Images",
            "Lateral Inversion",
            "Multiple Reflections"
          ],
          "formulae": [
            {
              "name": "Object-Image Distance Relation",
              "formula": "s' = -s"
            },
            {
              "name": "Lateral Magnification",
              "formula": "m = h'/h = -1"
            }
          ],
          "principles": [
            "Images in plane mirrors are virtual, upright, and same size as object",
            "Images appear to be behind the mirror at same distance as object is in front"
          ]
        },
        {
          "id": "concept-2-3",
          "title": "Spherical Mirrors",
          "subheadings": [
            "Concave Mirrors",
            "Convex Mirrors",
            "Focal Point and Focal Length",
            "Ray Diagrams for Spherical Mirrors",
            "Applications of Spherical Mirrors"
          ],
          "formulae": [
            {
              "name": "Mirror Equation",
              "formula": "1/s + 1/s' = 1/f"
            },
            {
              "name": "Magnification",
              "formula": "m = h'/h = -s'/s"
            },
            {
              "name": "Focal Length and Radius Relation",
              "formula": "f = R/2"
            }
          ],
          "principles": [
            "Sign conventions for mirror formula",
            "Real vs. virtual images in spherical mirrors",
            "Principal rays for image construction"
          ],
          "annotation": "Emphasize the sign convention carefully, as this is a common source of confusion for students. Consider creating a separate reference sheet for sign conventions used throughout optics."
        }
      ]
    },
    {
      "id": "section-3",
      "title": "Refraction and Lenses",
      "majorConcepts": [
        {
          "id": "concept-3-1",
          "title": "Refraction of Light",
          "subheadings": [
            "Snell's Law",
            "Index of Refraction",
            "Critical Angle and Total Internal Reflection",
            "Apparent Depth"
          ],
          "formulae": [
            {
              "name": "Snell's Law",
              "formula": "n₁sin(θ₁) = n₂sin(θ₂)"
            },
            {
              "name": "Critical Angle",
              "formula": "sin(θc) = n₂/n₁ (where n₁ > n₂)"
            },
            {
              "name": "Apparent Depth",
              "formula": "h' = h × (n₁/n₂)"
            }
          ],
          "principles": [
            "Light bends toward the normal when entering a denser medium",
            "Light bends away from the normal when entering a less dense medium",
            "Total internal reflection occurs when angle of incidence exceeds critical angle"
          ]
        },
        {
          "id": "concept-3-2",
          "title": "Thin Lenses",
          "subheadings": [
            "Converging (Convex) Lenses",
            "Diverging (Concave) Lenses",
            "Focal Length and Diopters",
            "Ray Diagrams for Lenses",
            "Real and Virtual Images"
          ],
          "formulae": [
            {
              "name": "Thin Lens Equation",
              "formula": "1/s + 1/s' = 1/f"
            },
            {
              "name": "Lens Magnification",
              "formula": "m = h'/h = s'/s"
            },
            {
              "name": "Lens Power (Diopters)",
              "formula": "P = 1/f (where f is in meters)"
            },
            {
              "name": "Lens Maker's Formula",
              "formula": "1/f = (n-1)(1/R₁ - 1/R₂)"
            }
          ],
          "principles": [
            "Sign conventions for lens formula",
            "Principal rays for image construction",
            "Types of images formed by converging vs. diverging lenses"
          ],
          "annotation": "Students frequently confuse lens and mirror sign conventions. Create clear visual aids distinguishing the two systems."
        },
        {
          "id": "concept-3-3",
          "title": "Applications of Lenses",
          "subheadings": [
            "Human Eye",
            "Corrective Lenses",
            "Cameras",
            "Projectors",
            "Magnifying Glass",
            "Compound Microscope",
            "Telescopes"
          ],
          "formulae": [
            {
              "name": "Angular Magnification",
              "formula": "M = 25 cm/f"
            },
            {
              "name": "Microscope Magnification",
              "formula": "M = -s'ₒ/s₀ × 25 cm/f_e"
            },
            {
              "name": "Telescope Magnification",
              "formula": "M = -f_o/f_e"
            }
          ],
          "principles": [
            "Near point and far point in vision",
            "Accommodation",
            "Resolution limits of optical instruments"
          ]
        }
      ]
    },
    {
      "id": "section-4",
      "title": "Wave Optics and Interference",
      "majorConcepts": [
        {
          "id": "concept-4-1",
          "title": "Interference of Light",
          "subheadings": [
            "Principle of Superposition",
            "Constructive and Destructive Interference",
            "Coherent Sources",
            "Young's Double-Slit Experiment",
            "Thin Film Interference"
          ],
          "formulae": [
            {
              "name": "Double-Slit Bright Fringes",
              "formula": "d sin(θ) = mλ (m = 0, ±1, ±2, ...)"
            },
            {
              "name": "Double-Slit Dark Fringes",
              "formula": "d sin(θ) = (m+1/2)λ (m = 0, ±1, ±2, ...)"
            },
            {
              "name": "Fringe Spacing",
              "formula": "Δy = Lλ/d"
            },
            {
              "name": "Thin Film Constructive Interference",
              "formula": "2nt = (m+1/2)λ (for 180° phase shift)"
            },
            {
              "name": "Thin Film Destructive Interference",
              "formula": "2nt = mλ (for 180° phase shift)"
            }
          ],
          "principles": [
            "Principle of superposition",
            "Phase difference and path difference",
            "Conditions for constructive and destructive interference",
            "Phase changes on reflection"
          ],
          "annotation": "The phase change on reflection is a subtle but crucial concept for thin film interference calculations. Dedicate extra time to this topic."
        },
        {
          "id": "concept-4-2",
          "title": "Diffraction",
          "subheadings": [
            "Single-Slit Diffraction",
            "Multiple-Slit Diffraction",
            "Diffraction Gratings",
            "Resolving Power",
            "X-ray Diffraction"
          ],
          "formulae": [
            {
              "name": "Single-Slit Diffraction Minima",
              "formula": "a sin(θ) = mλ (m = ±1, ±2, ...)"
            },
            {
              "name": "Diffraction Grating",
              "formula": "d sin(θ) = mλ (m = 0, ±1, ±2, ...)"
            },
            {
              "name": "Resolving Power of Grating",
              "formula": "R = λ/Δλ = Nm"
            },
            {
              "name": "Rayleigh Criterion",
              "formula": "sin(θ) = 1.22λ/D"
            }
          ],
          "principles": [
            "Huygens' principle",
            "Diffraction as interference phenomenon",
            "Resolving power of optical instruments",
            "Bragg's law for x-ray diffraction"
          ]
        },
        {
          "id": "concept-4-3",
          "title": "Polarization",
          "subheadings": [
            "Transverse Nature of Light",
            "Methods of Polarization",
            "Polarizers and Analyzers",
            "Malus' Law",
            "Applications of Polarization"
          ],
          "formulae": [
            {
              "name": "Malus' Law",
              "formula": "I = I₀cos²(θ)"
            },
            {
              "name": "Brewster's Angle",
              "formula": "tan(θp) = n₂/n₁"
            }
          ],
          "principles": [
            "Unpolarized vs. polarized light",
            "Polarization by absorption, reflection, and scattering",
            "Brewster's angle",
            "Optical activity"
          ]
        }
      ]
    },
    {
      "id": "section-5",
      "title": "Modern Optics and Applications",
      "majorConcepts": [
        {
          "id": "concept-5-1",
          "title": "Dispersion and Spectra",
          "subheadings": [
            "Dispersion in Prisms",
            "Rainbow Formation",
            "Absorption and Emission Spectra",
            "Spectroscopy and Applications"
          ],
          "formulae": [
            {
              "name": "Dispersion Relation",
              "formula": "n = f(λ)"
            },
            {
              "name": "Angular Dispersion",
              "formula": "dθ/dλ = d/(dcosθ)"
            }
          ],
          "principles": [
            "Wavelength dependence of refractive index",
            "Formation of continuous and line spectra",
            "Kirchhoff's laws of spectroscopy"
          ]
        },
        {
          "id": "concept-5-2",
          "title": "Optical Instruments and Technology",
          "subheadings": [
            "Digital Cameras and CCDs",
            "Fiber Optics",
            "Lasers",
            "Holography",
            "Adaptive Optics"
          ],
          "principles": [
            "Total internal reflection in fiber optics",
            "Stimulated emission in lasers",
            "Coherence in holography",
            "Resolution limitations and advances"
          ],
          "annotation": "Include modern applications like fiber optic communications, LASIK surgery, and astronomical adaptive optics to demonstrate relevance to students' lives."
        },
        {
          "id": "concept-5-3",
          "title": "Quantum Optics",
          "subheadings": [
            "Photoelectric Effect",
            "Photons",
            "Wave-Particle Duality",
            "Quantum Computing Applications"
          ],
          "formulae": [
            {
              "name": "Photoelectric Effect",
              "formula": "KE_max = hf - φ"
            },
            {
              "name": "Photon Energy",
              "formula": "E = hf = hc/λ"
            }
          ],
          "principles": [
            "Light as discrete packets of energy (photons)",
            "Wave-particle duality",
            "Quantum mechanical description of light"
          ],
          "annotation": "This section bridges classical optics to modern physics and can be adjusted based on curriculum scope."
        }
      ]
    }
