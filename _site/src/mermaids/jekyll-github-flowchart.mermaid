flowchart TD
    A[Markdown Files .md] --> B[Jekyll Build Process]
    B --> C[Generates Static HTML/CSS/JS]
    D[_config.yml Configuration] --> B
    E[Liquid Templates] --> B
    F[SASS/CSS Files] --> B
    G[JavaScript Files] --> B
    
    subgraph "Local Development"
        A
        B
        C
        D
        E
        F
        G
        H[jekyll serve Command]
        H --> I[Preview Site Locally]
    end
    
    J[Git Commit Changes] --> K[Git Push to GitHub Repository]
    
    subgraph "GitHub Actions/Pages"
        K --> L[GitHub Actions Workflow Triggered]
        L --> M[Jekyll Build on GitHub Server]
        M --> N[Static Files Generated]
        N --> O[Deployed to GitHub Pages]
    end
    
    O --> P[Site Available on username.github.io]
    
    style A fill:#f9d5e5,stroke:#333,stroke-width:2px
    style B fill:#eeac99,stroke:#333,stroke-width:2px
    style C fill:#e06377,stroke:#333,stroke-width:2px
    style O fill:#5b9aa0,stroke:#333,stroke-width:2px
    style P fill:#d6e5fa,stroke:#333,stroke-width:2px