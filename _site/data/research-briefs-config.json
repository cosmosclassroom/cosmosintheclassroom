{
  "version": "1.0.0",
  "research_briefs": {
    "storage_path": "/library/research-briefs",
    "index_file": "/data/research-briefs-index.json",
    "categories": [
      "phenomena",
      "historical", 
      "connections",
      "applications",
      "mathematical-frameworks"
    ],
    "difficulty_levels": [
      "exploratory",
      "standard", 
      "honors",
      "advanced"
    ]
  },
  "content_structure": {
    "brief_format": {
      "id": "string (unique identifier)",
      "title": "string",
      "type": "string (category)",
      "generated_date": "ISO 8601 timestamp",
      "related_units": ["array of unit IDs"],
      "related_concepts": ["array of concept tags"],
      "depth_level": "string (difficulty level)",
      "content": {
        "summary": "string (brief overview)",
        "key_questions": ["array of driving questions"],
        "historical_context": "string",
        "mathematical_framework": "string",
        "real_world_applications": ["array of applications"],
        "further_investigation": "string"
      },
      "socratic_prompts": [
        {
          "level": "string (clarification|evidence|perspective|meta)",
          "questions": ["array of questions"]
        }
      ],
      "assessment_connections": ["array of assessment IDs"],
      "library_resources": ["array of resource IDs"],
      "multimedia": {
        "diagrams": ["array of diagram files"],
        "simulations": ["array of simulation files"],
        "videos": ["array of video files"]
      },
      "metadata": {
        "author": "string",
        "review_status": "string",
        "last_updated": "ISO 8601 timestamp",
        "view_count": "number",
        "rating": "number"
      }
    }
  },
  "portal_integration": {
    "display_modes": [
      "embedded",
      "standalone", 
      "sidebar",
      "modal"
    ],
    "navigation_contexts": [
      "course_unit",
      "lesson_supplement",
      "assessment_prep",
      "library_browse",
      "search_results"
    ],
    "recommendation_triggers": [
      "unit_entry",
      "lesson_completion",
      "assessment_start",
      "concept_difficulty",
      "user_interest"
    ]
  }
}
